# Exaroton API token, from https://exaroton.com/account/
# With it the site reads server status, who is on, and the player stats.
# Without it, status falls back to api.mcsrvstat.us and stats are hidden.
EXAROTON_API_KEY=

# Your server ID from exaroton.com (optional, saves one API call per check)
EXAROTON_SERVER_ID=

# Hostname of the Exaroton server, used by the mcsrvstat fallback
# Defaults to stebbias.exaroton.me
EXAROTON_SERVER_HOST=

# Public URL of the site, used for Open Graph links (optional)
NEXT_PUBLIC_SITE_URL=https://jodcraft.world
