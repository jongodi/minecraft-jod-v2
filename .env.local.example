# Exaroton API — get your token at https://exaroton.com/account/
# When set, server status is fetched directly from Exaroton (more reliable)
# Without this, falls back to api.mcsrvstat.us
EXAROTON_API_KEY=

# The hostname of your Exaroton server (e.g. yourname.exaroton.me)
# Defaults to stebbias.exaroton.me if not set
EXAROTON_SERVER_HOST=

# Optional: your server ID (avoids an extra API lookup on every request)
# Find it in the URL when viewing your server on exaroton.com
EXAROTON_SERVER_ID=

# Optional: BlueMap's web folder on the server, if it isn't bluemap/web
# (the `webroot` in plugins/BlueMap/webapp.conf; npm run map:sync finds it on its own)
BLUEMAP_WEBROOT=

# Admin panel password — set to any secret string (min 8 chars), used to log in to /admin
ADMIN_TOKEN=

# GitHub token (optional) — increases rate limit for datapack update checks from 60 to 5000 req/hr
# Create at https://github.com/settings/tokens (classic, no scopes needed for public repos)
GITHUB_TOKEN=

# GitHub token for the admin panel's "copy the map now" button, which starts the
# Map sync workflow. Fine-grained, this repository only, "Actions: Read and write"
MAP_SYNC_GITHUB_TOKEN=

# Secret for the scheduled jobs (/api/cron/daily and /api/cron/nights in
# vercel.json): Vercel sends it as a bearer token, and the jobs turn away
# anything without it. Any long random string.
CRON_SECRET=

# Optional: the site's own address, used in sign-in links and in email.
# Defaults to the address the admin panel was opened on, and to
# https://jodcraft.world in email.
NEXT_PUBLIC_SITE_URL=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign-in links and play-night letters go through resend.com, from the
# jodcraft.world domain verified there. Without the key nothing is sent.
# Set it for Production only in Vercel, so preview deployments stay quiet.
RESEND_API_KEY=
# Optional: who the letters are from; defaults to JOÐ <hallo@jodcraft.world>
EMAIL_FROM=
# Optional: where replies go, if not to the From address
EMAIL_REPLY_TO=

# Crew member tokens — one per player, used for crew profile login
# Format: CREW_TOKEN_<UPPERCASE_USERNAME>=<secret>
CREW_TOKEN_STEBBIAS=
CREW_TOKEN_AMMAGAUR=
CREW_TOKEN_JOENANA=
CREW_TOKEN_INGUNNBIRTA=
CREW_TOKEN_GAMLA123=
CREW_TOKEN_FAFNIR1994=
CREW_TOKEN_IMLONELY=
CREW_TOKEN_EIKIBLEIKI=

# ─── Vercel Storage (required for production) ─────────────────────────────────
# Redis — stores crew profiles, posts, gallery metadata, and stat snapshots
# Add via: Vercel Dashboard → Storage → Create Redis Database
# The REDIS_URL is shown in the database dashboard and auto-added when connected
REDIS_URL=

# Vercel Blob — stores uploaded photos (gallery + crew) and the BlueMap map data
# Add via: Vercel Dashboard → Storage → Create Blob Store
# Also needed locally for `npm run map:sync`, which uploads the map data there
BLOB_READ_WRITE_TOKEN=
