+package de.bluecolored.bluemap.entities.filter;
+
+import com.flowpowered.math.vector.Vector3d;
+import de.bluecolored.bluemap.core.map.hires.ArrayTileModel;
+import de.bluecolored.bluemap.core.map.hires.TileModelView;
+import de.bluecolored.bluemap.core.map.hires.entity.EntityRenderer;
+import de.bluecolored.bluemap.core.map.hires.entity.EntityRendererType;
+import de.bluecolored.bluemap.core.resources.ResourcePath;
+import de.bluecolored.bluemap.core.resources.pack.ResourcePool;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.entitystate.EntityState;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.entitystate.Part;
+import de.bluecolored.bluemap.core.util.Key;
+import de.bluecolored.bluemap.core.world.Entity;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static de.bluecolored.bluemap.entities.Nbt.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityFilterTest {
+
+    private static final RenderBox BOX = RenderBox.DEFAULT;
+
+    @Test
+    void boxBoundsAreInclusiveBlockCoordinates() {
+        assertTrue(BOX.contains(new Vector3d(-6975.0, 60.0, -8878.0)));
+        assertTrue(BOX.contains(new Vector3d(-6868.01, 90.99, -8792.01))); // still in blocks -6869 / 90 / -8793
+        assertFalse(BOX.contains(new Vector3d(-6868.0, 70, -8800)));
+        assertFalse(BOX.contains(new Vector3d(-6975.01, 70, -8800)));
+        assertFalse(BOX.contains(new Vector3d(-6900, 59.99, -8800)));
+        assertFalse(BOX.contains(new Vector3d(-6900, 91.0, -8800)));
+        assertFalse(BOX.contains(new Vector3d(-6900, 70, -8792.0)));
+        assertFalse(BOX.contains(new Vector3d(-6900, 70, -8878.01)));
+    }
+
+    @Test
+    void missingConfigIsCreatedWithTheDefaults(@TempDir Path dir) throws Exception {
+        Path file = dir.resolve(RenderBox.FILE_NAME);
+        assertEquals(BOX, RenderBox.load(file));
+        String text = Files.readString(file);
+        assertTrue(text.contains("min-x=-6975") && text.contains("max-x=-6869"), text);
+        assertTrue(text.contains("min-y=60") && text.contains("max-y=90"), text);
+        assertTrue(text.contains("min-z=-8878") && text.contains("max-z=-8793"), text);
+        assertEquals(BOX, RenderBox.load(file)); // and reads back the same
+    }
+
+    @Test
+    void configIsParsedLeniently(@TempDir Path dir) throws Exception {
+        Path file = dir.resolve(RenderBox.FILE_NAME);
+        Files.writeString(file, """
+                # swapped x bounds, a broken y, z missing
+                min-x = 10
+                max-x = -10
