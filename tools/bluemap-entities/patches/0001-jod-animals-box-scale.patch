diff --git a/src/main/java/de/bluecolored/bluemap/entities/data/AttributeScaleDeserializer.java b/src/main/java/de/bluecolored/bluemap/entities/data/AttributeScaleDeserializer.java
new file mode 100644
index 0000000..48de7c5
--- /dev/null
+++ b/src/main/java/de/bluecolored/bluemap/entities/data/AttributeScaleDeserializer.java
@@ -0,0 +1,136 @@
+package de.bluecolored.bluemap.entities.data;
+
+import de.bluecolored.bluenbt.NBTReader;
+import de.bluecolored.bluenbt.TagType;
+import de.bluecolored.bluenbt.TypeDeserializer;
+import org.jetbrains.annotations.Nullable;
+
+import java.io.IOException;
+
+/**
+ * Reads the final value of the <code>minecraft:scale</code> attribute from a living entity's saved
+ * <code>attributes</code> list. Since 1.21.2 (and still in 26.2) the list looks like
+ * <pre>attributes: [{id: "minecraft:scale", base: 2.0d, modifiers: [{id: "...", amount: 0.5d, operation: "add_value"}]}]</pre>
+ * The value is computed like vanilla's <code>AttributeInstance#calculateValue</code>.
+ * <p>
+ * Malformed entries are skipped instead of throwing: a failed field makes BlueMap drop the whole entity-class,
+ * and the entity would then not render at all.
+ * </p>
+ */
+public class AttributeScaleDeserializer implements TypeDeserializer<Float> {
+
+    // vanilla: new RangedAttribute("attribute.name.scale", 1.0, 0.0625, 16.0)
+    public static final float DEFAULT_SCALE = 1f;
+    private static final double MIN_SCALE = 0.0625, MAX_SCALE = 16.0;
+
+    @Override
+    public Float read(NBTReader reader) throws IOException {
+        if (reader.peek() != TagType.LIST) {
+            reader.skip();
+            return DEFAULT_SCALE;
+        }
+
+        float scale = DEFAULT_SCALE;
+        reader.beginList();
+        while (reader.hasNext()) {
+            if (reader.peek() != TagType.COMPOUND) {
+                reader.skip();
+                continue;
+            }
+            Double value = readScaleAttribute(reader);
+            if (value != null) scale = value.floatValue();
+        }
+        reader.endList();
+        return scale;
+    }
+
+    /** reads one attribute compound and returns its final value, or null if it is not the scale attribute */
+    private static @Nullable Double readScaleAttribute(NBTReader reader) throws IOException {
+        String id = null;
+        double base = DEFAULT_SCALE;
+        double addValue = 0, addMultipliedBase = 0, multiplyTotal = 1;
+
+        reader.beginCompound();
+        while (reader.hasNext()) {
+            String name = reader.name();
+            TagType type = reader.peek();
+
+            if (name.equals("id") && type == TagType.STRING) {
+                id = reader.nextString();
+            } else if (name.equals("base") && isNumber(type)) {
+                base = readNumber(reader);
+            } else if (name.equals("modifiers") && type == TagType.LIST) {
+                reader.beginList();
+                while (reader.hasNext()) {
+                    if (reader.peek() != TagType.COMPOUND) {
+                        reader.skip();
+                        continue;
+                    }
+
+                    double amount = 0;
+                    String operation = null;
+                    reader.beginCompound();
+                    while (reader.hasNext()) {
+                        String modifierName = reader.name();
+                        TagType modifierType = reader.peek();
+                        if (modifierName.equals("amount") && isNumber(modifierType)) {
+                            amount = readNumber(reader);
+                        } else if (modifierName.equals("operation") && modifierType == TagType.STRING) {
+                            operation = reader.nextString();
+                        } else {
+                            reader.skip();
+                        }
+                    }
+                    reader.endCompound();
+
+                    if (operation == null) continue;
+                    switch (operation) {
+                        case "add_value" -> addValue += amount;
+                        case "add_multiplied_base" -> addMultipliedBase += amount;
+                        case "add_multiplied_total" -> multiplyTotal *= 1 + amount;
+                        default -> {}
+                    }
+                }
+                reader.endList();
+            } else {
+                reader.skip();
+            }
+        }
+        reader.endCompound();
+
+        if (!isScale(id)) return null;
+
+        double value = base + addValue;
+        value += value * addMultipliedBase;
+        value *= multiplyTotal;
+
+        if (Double.isNaN(value)) return MIN_SCALE;
+        return Math.clamp(value, MIN_SCALE, MAX_SCALE);
+    }
+
+    private static boolean isScale(@Nullable String id) {
+        if (id == null) return false;
+        if (id.startsWith("minecraft:")) id = id.substring("minecraft:".length());
+        return id.equals("scale") || id.equals("generic.scale"); // generic.scale: worlds saved before 1.21.2
+    }
+
+    private static boolean isNumber(TagType type) {
+        return switch (type) {
+            case BYTE, SHORT, INT, LONG, FLOAT, DOUBLE -> true;
+            default -> false;
+        };
+    }
+
+    private static double readNumber(NBTReader reader) throws IOException {
+        return switch (reader.peek()) {
+            case BYTE -> reader.nextByte();
+            case SHORT -> reader.nextShort();
+            case INT -> reader.nextInt();
+            case LONG -> reader.nextLong();
+            case FLOAT -> reader.nextFloat();
+            case DOUBLE -> reader.nextDouble();
+            default -> throw new IllegalStateException("Not a number: " + reader.peek());
+        };
+    }
+
+}
