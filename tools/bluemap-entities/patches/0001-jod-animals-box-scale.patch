+    @Test
+    void scaleIsAppliedToTheRenderedPartOnly() throws Exception {
+        ArrayTileModel model = new ArrayTileModel(8);
+        TileModelView view = new TileModelView(model);
+
+        // a part that was rendered before, it has to stay as it is
+        int earlier = view.initialize().add(1);
+        model.setPositions(earlier, 1, 1, 1, 1, 1, 1, 1, 1, 1);
+
+        Entity cow = read(scaled("minecraft:cow", -6900.5, 70, -8820.5, 3.0));
