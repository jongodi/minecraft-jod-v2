@@ -0,0 +1,100 @@
+package de.bluecolored.bluemap.entities;
+
+import de.bluecolored.bluemap.core.world.Entity;
+import de.bluecolored.bluemap.entities.entity.AgeVariantEntity;
+import de.bluecolored.bluemap.entities.entity.Horse;
+import de.bluecolored.bluemap.entities.entity.LivingEntity;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static de.bluecolored.bluemap.entities.Nbt.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class AttributeScaleTest {
+
+    private static float scaleOf(Map<String, Object> entity) {
+        Entity parsed = read(entity);
+        assertInstanceOf(LivingEntity.class, parsed, "parsed as " + parsed.getClass());
+        return ((LivingEntity) parsed).getAttributeScale();
+    }
+
+    private static Map<String, Object> withAttributes(String id, Object attributes) {
+        Map<String, Object> entity = entity(id, -6900.5, 70, -8820.5);
+        entity.put("attributes", attributes);
+        return entity;
+    }
+
+    @Test
+    void baseValue() {
+        assertEquals(2f, scaleOf(withAttributes("minecraft:cow", List.of(
+                attribute("minecraft:max_health", 10.0),
+                attribute("minecraft:scale", 2.0),
+                attribute("minecraft:movement_speed", 0.2)
+        ))));
+    }
+
+    @Test
+    void modifiersCombineLikeVanilla() {
+        // (1 + 1) = 2, * (1 + 0.5) = 3, * (1 + 1) = 6
+        assertEquals(6f, scaleOf(withAttributes("minecraft:sheep", List.of(attribute("minecraft:scale", 1.0,
+                modifier(1.0, "add_multiplied_total"),
+                modifier(0.5, "add_multiplied_base"),
+                modifier(1.0, "add_value")
+        )))));
+    }
+
+    @Test
+    void clampedToVanillaRange() {
+        assertEquals(16f, scaleOf(withAttributes("minecraft:pig", List.of(attribute("minecraft:scale", 100.0)))));
+        assertEquals(0.0625f, scaleOf(withAttributes("minecraft:pig", List.of(attribute("minecraft:scale", 0.0)))));
+    }
+
+    @Test
+    void defaultsToOne() {
+        assertEquals(1f, scaleOf(entity("minecraft:cow", 0, 64, 0)));
+        assertEquals(1f, scaleOf(withAttributes("minecraft:cow", List.of(attribute("minecraft:max_health", 10.0)))));
+        assertEquals(1f, scaleOf(withAttributes("minecraft:cow", List.of())));
+    }
+
+    @Test
+    void legacyIdAndOtherNumberTypes() {
+        assertEquals(3f, scaleOf(withAttributes("minecraft:chicken", List.of(attribute("minecraft:generic.scale", 3.0)))));
+        assertEquals(2f, scaleOf(withAttributes("minecraft:chicken", List.of(attribute("scale", 2)))));
+        assertEquals(2.5f, scaleOf(withAttributes("minecraft:chicken", List.of(attribute("minecraft:scale", 2.5f)))));
+    }
+
+    @Test
+    void malformedAttributesKeepTheEntity() {
+        // attributes as a compound instead of a list
+        Entity entity = read(withAttributes("minecraft:cow", Map.of("id", "minecraft:scale", "base", 3.0)));
+        assertInstanceOf(AgeVariantEntity.class, entity);
+        assertEquals(1f, ((LivingEntity) entity).getAttributeScale());
+
+        // a base that is not a number, modifiers that are not compounds or miss their operation
+        Map<String, Object> broken = attribute("minecraft:scale", "big");
+        broken.put("modifiers", List.of(1, 2, 3));
+        assertEquals(1f, scaleOf(withAttributes("minecraft:cow", List.of(broken))));
+        assertEquals(2f, scaleOf(withAttributes("minecraft:cow", List.of(attribute("minecraft:scale", 2.0,
+                Map.of("id", "minecraft:x", "amount", 5.0))))));
+    }
+
+    @Test
+    void entitiesKeepTheirAddonClass() {
+        Map<String, Object> horse = withAttributes("minecraft:horse", List.of(attribute("minecraft:scale", 4.0)));
+        horse.put("Variant", 3);
+        Entity parsed = read(horse);
+        assertInstanceOf(Horse.class, parsed);
+        assertEquals(3, ((Horse) parsed).getVariant());
+        assertEquals(4f, ((Horse) parsed).getAttributeScale());
+    }
+
+    @Test
+    void animalsWithoutAnOwnClassGetTheScaleToo() {
+        assertEquals(2f, scaleOf(withAttributes("minecraft:bat", List.of(attribute("minecraft:scale", 2.0)))));
+        assertEquals(2f, scaleOf(withAttributes("minecraft:cod", List.of(attribute("minecraft:scale", 2.0)))));
+        assertEquals(2f, scaleOf(withAttributes("minecraft:tadpole", List.of(attribute("minecraft:scale", 2.0)))));
+    }
+
+}
