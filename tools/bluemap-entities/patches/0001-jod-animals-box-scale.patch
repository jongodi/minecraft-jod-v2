--- /dev/null
+++ b/src/main/java/de/bluecolored/bluemap/entities/filter/EntityFilterExtension.java
@@ -0,0 +1,70 @@
+package de.bluecolored.bluemap.entities.filter;
+
+import de.bluecolored.bluemap.core.map.hires.entity.EntityRendererType;
+import de.bluecolored.bluemap.core.resources.pack.ResourcePool;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.ResourcePack;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.ResourcePackExtension;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.entitystate.EntityState;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.entitystate.Part;
+import de.bluecolored.bluemap.core.util.Key;
+import de.bluecolored.bluemap.entities.Addon;
+import lombok.RequiredArgsConstructor;
+
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Runs after BlueMap has loaded all resource-packs (on startup and on every <code>/bluemap reload</code>):
+ * <ul>
+ *     <li>drops the entity-state of everything that is not one of the {@link Animals}, so BlueMap never renders
+ *     those entities, whichever pack the entity-state came from</li>
+ *     <li>routes every part that is left through {@link FilteredRendererType} (box filter and scale attribute),
+ *     including parts that use BlueMap's own default renderer</li>
+ * </ul>
+ */
+@RequiredArgsConstructor
+public class EntityFilterExtension implements ResourcePackExtension {
+
+    public static final ResourcePack.Extension<EntityFilterExtension> TYPE = new ResourcePack.Extension<>() {
+        private final Key key = new Key("bluemap_entities", "entity_filter");
+
+        @Override
+        public Key getKey() {
+            return key;
+        }
+
+        @Override
+        public EntityFilterExtension create(ResourcePack pack) {
+            return new EntityFilterExtension(pack);
+        }
+    };
+
+    private final ResourcePack resourcePack;
+
+    @Override
+    public void loadResources(Iterable<Path> roots) {
+        Path file = RenderBox.configFile();
+        RenderBox box = RenderBox.load(file);
+        apply(resourcePack.getEntityStates(), box);
+        Addon.LOGGER.info("Rendering only animals inside " + box + " (" + file + ")");
+    }
+
+    static void apply(ResourcePool<EntityState> entityStates, RenderBox box) {
+        entityStates.keySet().removeIf(type ->
+                !type.getNamespace().equals(Key.BLUEMAP_NAMESPACE) &&
+                !Animals.TYPES.contains(type)
+        );
+
+        Map<EntityRendererType, EntityRendererType> filtered = new HashMap<>();
+        for (EntityState state : entityStates.values()) {
+            Part[] parts = state.getParts();
+            if (parts == null) continue;
+            for (Part part : parts) {
+                if (part == null || part.getRenderer() instanceof FilteredRendererType) continue;
+                part.setRenderer(filtered.computeIfAbsent(part.getRenderer(), type -> new FilteredRendererType(type, box)));
+            }
+        }
+    }
+
+}
diff --git a/src/main/java/de/bluecolored/bluemap/entities/filter/FilteredRendererType.java b/src/main/java/de/bluecolored/bluemap/entities/filter/FilteredRendererType.java
