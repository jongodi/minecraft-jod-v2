@@ -0,0 +1,59 @@
+package de.bluecolored.bluemap.entities.filter;
+
+import de.bluecolored.bluemap.core.map.TextureGallery;
+import de.bluecolored.bluemap.core.map.hires.RenderSettings;
+import de.bluecolored.bluemap.core.map.hires.TileModelView;
+import de.bluecolored.bluemap.core.map.hires.entity.EntityRenderer;
+import de.bluecolored.bluemap.core.map.hires.entity.EntityRendererType;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.ResourcePack;
+import de.bluecolored.bluemap.core.resources.pack.resourcepack.entitystate.Part;
+import de.bluecolored.bluemap.core.util.Key;
+import de.bluecolored.bluemap.core.world.Entity;
+import de.bluecolored.bluemap.core.world.block.BlockNeighborhood;
+import de.bluecolored.bluemap.entities.entity.LivingEntity;
+import lombok.RequiredArgsConstructor;
+
+/**
+ * Wraps the renderer of an entity-state part: entities outside the {@link RenderBox} are skipped, and the part is
+ * scaled by the entity's <code>minecraft:scale</code> attribute.
+ */
+@RequiredArgsConstructor
+public class FilteredRendererType implements EntityRendererType {
+
+    private final EntityRendererType delegate;
+    private final RenderBox box;
+
+    @Override
+    public Key getKey() {
+        return delegate.getKey();
+    }
+
+    @Override
+    public EntityRenderer create(ResourcePack resourcePack, TextureGallery textureGallery, RenderSettings renderSettings) {
+        return new Renderer(delegate.create(resourcePack, textureGallery, renderSettings), box);
+    }
+
+    @RequiredArgsConstructor
+    private static class Renderer implements EntityRenderer {
+
+        private final EntityRenderer delegate;
+        private final RenderBox box;
+
+        @Override
+        public void render(Entity entity, BlockNeighborhood block, Part part, TileModelView tileModel) {
+            if (!box.contains(entity.getPos())) return;
+
+            int start = tileModel.getStart();
+            delegate.render(entity, block, part, tileModel);
+
+            // the model is still in entity space here (origin at the feet, not yet rotated or moved into place),
+            // so this scales it around the feet like the game does
+            if (entity instanceof LivingEntity living && living.getAttributeScale() != 1f) {
+                float scale = living.getAttributeScale();
+                tileModel.initialize(start).scale(scale, scale, scale);
+            }
+        }
+
+    }
+
+}
diff --git a/src/main/java/de/bluecolored/bluemap/entities/filter/RenderBox.java b/src/main/java/de/bluecolored/bluemap/entities/filter/RenderBox.java
new file mode 100644
index 0000000..e3c5af9
--- /dev/null
+++ b/src/main/java/de/bluecolored/bluemap/entities/filter/RenderBox.java
@@ -0,0 +1,111 @@
+package de.bluecolored.bluemap.entities.filter;
+
+import com.flowpowered.math.vector.Vector3d;
+import de.bluecolored.bluemap.entities.Addon;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Properties;
+import java.util.logging.Level;
+
+/**
+ * The box entities are rendered in, in block coordinates (as F3 shows them), both bounds included.
+ * <p>
+ * It is read from a small properties file next to the addon jar every time BlueMap loads its resources
+ * (startup and <code>/bluemap reload</code>), and written with the defaults if it is missing.
+ * </p>
+ */
+public record RenderBox(int minX, int maxX, int minY, int maxY, int minZ, int maxZ) {
+
+    public static final String FILE_NAME = "bluemap-entities.properties";
+    public static final RenderBox DEFAULT = new RenderBox(-6975, -6869, 60, 90, -8878, -8793);
+
+    public RenderBox {
+        if (minX > maxX) { int t = minX; minX = maxX; maxX = t; }
+        if (minY > maxY) { int t = minY; minY = maxY; maxY = t; }
+        if (minZ > maxZ) { int t = minZ; minZ = maxZ; maxZ = t; }
+    }
+
+    public boolean contains(Vector3d pos) {
+        int x = pos.getFloorX(), y = pos.getFloorY(), z = pos.getFloorZ();
+        return
+                x >= minX && x <= maxX &&
+                y >= minY && y <= maxY &&
+                z >= minZ && z <= maxZ;
+    }
+
+    @Override
+    public String toString() {
+        return "x %d..%d, y %d..%d, z %d..%d".formatted(minX, maxX, minY, maxY, minZ, maxZ);
+    }
+
+    /** next to the addon jar (plugins/BlueMap/packs on Paper), or the working directory if the jar can't be located */
+    public static Path configFile() {
+        try {
+            Path jar = Path.of(RenderBox.class.getProtectionDomain().getCodeSource().getLocation().toURI());
+            if (Files.isRegularFile(jar)) return jar.resolveSibling(FILE_NAME);
+        } catch (Exception ignore) {}
+        return Path.of(FILE_NAME).toAbsolutePath();
+    }
+
+    public static RenderBox load(Path file) {
+        if (!Files.exists(file)) {
+            try {
+                Files.writeString(file, DEFAULT.toConfig());
+                Addon.LOGGER.info("Created " + file + " with the default render box.");
+            } catch (IOException ex) {
+                Addon.LOGGER.log(Level.WARNING, "Failed to create " + file + ", using the default render box.", ex);
+            }
+            return DEFAULT;
+        }
+
+        Properties properties = new Properties();
+        try (Reader reader = Files.newBufferedReader(file)) {
+            properties.load(reader);
+        } catch (IOException | IllegalArgumentException ex) {
+            Addon.LOGGER.log(Level.WARNING, "Failed to read " + file + ", using the default render box.", ex);
+            return DEFAULT;
+        }
+
+        return new RenderBox(
+                read(properties, file, "min-x", DEFAULT.minX),
+                read(properties, file, "max-x", DEFAULT.maxX),
+                read(properties, file, "min-y", DEFAULT.minY),
+                read(properties, file, "max-y", DEFAULT.maxY),
+                read(properties, file, "min-z", DEFAULT.minZ),
+                read(properties, file, "max-z", DEFAULT.maxZ)
+        );
+    }
+
+    private static int read(Properties properties, Path file, String key, int fallback) {
+        String value = properties.getProperty(key);
+        if (value == null) {
+            Addon.LOGGER.warning("'" + key + "' is missing in " + file + ", using " + fallback + ".");
+            return fallback;
+        }
+        try {
+            return Integer.parseInt(value.strip());
+        } catch (NumberFormatException ex) {
+            Addon.LOGGER.warning("'" + key + "' in " + file + " is not a whole number (" + value + "), using " + fallback + ".");
+            return fallback;
+        }
+    }
+
+    String toConfig() {
+        return """
+                # BlueMap Entities (patched build)
+                # Only animals standing inside this box are rendered on the map, everything outside it is skipped.
+                # Block coordinates as F3 shows them, both bounds are included.
+                # After editing: /bluemap reload, then re-render the area (/bluemap force-update ...).
+                min-x=%d
+                max-x=%d
+                min-y=%d
+                max-y=%d
+                min-z=%d
+                max-z=%d
+                """.formatted(minX, maxX, minY, maxY, minZ, maxZ);
+    }
+
+}
