+    private static EntityState state() {
+        return new EntityState(new Part[]{ new Part(new ResourcePath<>(Key.MINECRAFT_NAMESPACE, "entity/test")) });
+    }
+
+    /** renders one face (1,2,3 .. 7,8,9) through the filter, returns whether the wrapped renderer was called */
+    private static boolean render(Entity entity, TileModelView view) {
+        boolean[] called = { false };
+        EntityRendererType face = new EntityRendererType.Impl(Key.bluemap("test"), (pack, gallery, settings) ->
+                (e, block, part, tileModel) -> {
+                    called[0] = true;
+                    int f = tileModel.add(1);
+                    tileModel.getTileModel().setPositions(f, 1, 2, 3, 4, 5, 6, 7, 8, 9);
+                });
+        EntityRenderer renderer = new FilteredRendererType(face, BOX).create(null, null, null);
+        renderer.render(entity, null, null, view);
+        return called[0];
+    }
+
+    private static float[] positions(ArrayTileModel model) throws ReflectiveOperationException {
+        Field field = ArrayTileModel.class.getDeclaredField("position");
+        field.setAccessible(true);
+        return (float[]) field.get(model);
+    }
