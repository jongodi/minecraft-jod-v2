@@ -0,0 +1,103 @@
+package de.bluecolored.bluemap.entities;
+
+import de.bluecolored.bluemap.core.world.Entity;
+import de.bluecolored.bluemap.core.world.mca.MCAUtil;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Writes entity NBT like the game saves it in entities/*.mca, and reads it back with BlueMap's own deserializer. */
+public final class Nbt {
+
+    static {
+        new Addon().run(); // register the addon's entity classes before BlueMap builds its entity deserializer
+    }
+
+    private Nbt() {}
+
+    public static Map<String, Object> entity(String id, double x, double y, double z) {
+        Map<String, Object> nbt = new LinkedHashMap<>();
+        nbt.put("id", id);
+        nbt.put("Pos", List.of(x, y, z));
+        nbt.put("Rotation", List.of(90f, 0f));
+        nbt.put("Age", 0);
+        return nbt;
+    }
+
+    public static Map<String, Object> attribute(String id, Object base, Object... modifiers) {
+        Map<String, Object> nbt = new LinkedHashMap<>();
+        nbt.put("id", id);
+        nbt.put("base", base);
+        if (modifiers.length > 0) nbt.put("modifiers", List.of(modifiers));
+        return nbt;
+    }
+
+    public static Map<String, Object> modifier(double amount, String operation) {
+        Map<String, Object> nbt = new LinkedHashMap<>();
+        nbt.put("id", "minecraft:datapack_size");
+        nbt.put("amount", amount);
+        nbt.put("operation", operation);
+        return nbt;
+    }
+
+    public static Entity read(Map<String, Object> entity) {
+        try {
+            return MCAUtil.BLUENBT.read(new ByteArrayInputStream(write(entity)), Entity.class);
+        } catch (IOException ex) {
+            throw new UncheckedIOException(ex);
+        }
+    }
+
+    static byte[] write(Map<String, Object> root) throws IOException {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        DataOutputStream out = new DataOutputStream(bytes);
+        out.writeByte(10);
+        out.writeUTF("");
+        writePayload(out, root);
+        return bytes.toByteArray();
+    }
+
+    private static int tagType(Object value) {
+        return switch (value) {
+            case Byte b -> 1;
+            case Integer i -> 3;
+            case Float f -> 5;
+            case Double d -> 6;
+            case String s -> 8;
+            case List<?> l -> 9;
+            case Map<?, ?> m -> 10;
+            default -> throw new IllegalArgumentException("unsupported: " + value);
+        };
+    }
+
+    private static void writePayload(DataOutputStream out, Object value) throws IOException {
+        switch (value) {
+            case Byte b -> out.writeByte(b);
+            case Integer i -> out.writeInt(i);
+            case Float f -> out.writeFloat(f);
+            case Double d -> out.writeDouble(d);
+            case String s -> out.writeUTF(s);
+            case List<?> list -> {
+                out.writeByte(list.isEmpty() ? 0 : tagType(list.getFirst()));
+                out.writeInt(list.size());
+                for (Object element : list) writePayload(out, element);
+            }
+            case Map<?, ?> map -> {
+                for (Map.Entry<?, ?> entry : map.entrySet()) {
+                    out.writeByte(tagType(entry.getValue()));
+                    out.writeUTF((String) entry.getKey());
+                    writePayload(out, entry.getValue());
+                }
+                out.writeByte(0);
+            }
+            default -> throw new IllegalArgumentException("unsupported: " + value);
+        }
+    }
+
+}
