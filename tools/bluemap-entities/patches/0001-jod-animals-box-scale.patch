+                "oak_boat", "poplar_boat", "minecart", "armor_stand", "cushion", "item_frame", "painting"))
+            states.put(Key.minecraft(type), state());
+        states.put(Key.bluemap("missing"), state());
+
+        EntityFilterExtension.apply(states, BOX);
+
+        assertEquals(Set.of(Key.minecraft("cow"), Key.minecraft("bat"), Key.bluemap("missing")), Set.copyOf(states.keySet()));
+
+        EntityRendererType cow = states.get(Key.minecraft("cow")).getParts()[0].getRenderer();
+        EntityRendererType bat = states.get(Key.minecraft("bat")).getParts()[0].getRenderer();
+        assertInstanceOf(FilteredRendererType.class, cow);
+        assertSame(cow, bat, "one wrapper per wrapped renderer");
+        assertEquals(EntityRendererType.DEFAULT.getKey(), cow.getKey());
+
+        EntityFilterExtension.apply(states, BOX);
+        assertSame(cow, states.get(Key.minecraft("cow")).getParts()[0].getRenderer(), "not wrapped twice");
+    }
